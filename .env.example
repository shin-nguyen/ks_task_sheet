# Copy this file to .env and adjust for your environment.
# docker-compose reads .env automatically.

# --- Database ---
DB_NAME=kstasks
DB_USER=kstasks
DB_PASSWORD=kstasks
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
# Generate a real secret for anything beyond local/demo use, e.g.: openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-32bytes
# Set to true when serving the app over HTTPS
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5180
# "seed" loads demo users/epic/tasks on first boot (only if the users table is empty). Set to "" to disable.
SPRING_PROFILES_ACTIVE=seed

# --- Frontend ---
FRONTEND_PORT=5180
